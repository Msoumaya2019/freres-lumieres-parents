{
  "name": "@flp/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "expo:check": "expo install --check",
    "expo:config": "expo config --type public",
    "prebuild:ios": "expo prebuild --platform ios --clean --no-install",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "expo export --platform web --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@flp/shared": "workspace:*",
    "@flp/firebase-config": "workspace:*",
    "@flp/types": "workspace:*",
    "@flp/validation": "workspace:*",
    "@firebase/auth": "1.13.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.20",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "firebase": "12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
