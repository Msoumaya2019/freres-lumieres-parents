{
  "name": "@fl/functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions : Custom Claims, compteurs, notifications et actions privilégiées",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fl/shared": "*",
    "@fl/types": "*",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
