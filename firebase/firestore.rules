rules_version = '2';

// =============================================================================
//  Règles Firestore — FCPE Frères Lumières
// =============================================================================
//
//  PRINCIPE FONDAMENTAL
//  --------------------
//  Le client est hostile par conception. La configuration Firebase embarquée
//  dans l'application est publique : n'importe qui peut appeler Firestore
//  directement avec un script. Ces règles sont donc la SEULE barrière réelle.
//
//  TROIS RÈGLES D'OR APPLIQUÉES ICI
//  --------------------------------
//  1. Échec fermé : en cas de doute, on refuse.
//  2. Les rôles viennent des Custom Claims, jamais d'une lecture de document.
//     Cela évite une lecture facturée à chaque évaluation de règle, et rend
//     impossible l'escalade de privilèges en modifiant son propre profil.
//  3. Les champs sensibles sont figés à l'écriture : identifiant d'auteur,
//     organisation, compteurs, rôle et statut.
//
//  CONTRAINTE TECHNIQUE IMPORTANTE — « les règles ne sont pas des filtres »
//  ----------------------------------------------------------------------
//  Pour une requête (`list`), Firestore n'accepte la règle que si elle est
//  **démontrable à partir des contraintes de la requête**. Une règle qui
//  compare un champ du document à une valeur non contrainte par la requête
//  fait échouer la requête entière.
//
//  C'est pourquoi les règles de lecture des contenus s'appuient sur les deux
//  seuls champs que les requêtes contraignent toujours : `orgId` et `status`.
//
//  CONSÉQUENCE ASSUMÉE ET DOCUMENTÉE
//  ---------------------------------
//  Le ciblage fin (école, niveau, classe) est appliqué par la requête du
//  client via les clés d'audience. Il ne constitue PAS une frontière de
//  confidentialité : un parent techniquement averti pourrait, en écrivant sa
//  propre requête, lire une publication destinée à un autre niveau de sa
//  propre école. L'impact est faible — ces contenus sont diffusés par la FCPE
//  à l'ensemble des familles du même groupe scolaire.
//
//  Les vraies frontières, elles, sont garanties par ces règles :
//    - l'organisation (`orgId`) : aucune fuite entre deux groupes scolaires ;
//    - l'espace privé de la FCPE : collections dédiées + contrôle du rôle ;
//    - les signalements : strictement privés, auteur ou FCPE ;
//    - les comptes utilisateurs : soi-même, ou rôle habilité ;
//    - le journal d'audit : écriture serveur uniquement, lecture admin.
//
//  Toute règle qui ne serait pas vérifiable par Firestore doit être retirée
//  plutôt que contournée. La vérification est faite par les tests d'émulateur
//  de `packages/testing` (Phases 2 et 12).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    //  Helpers
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    // Un compte `pending`, `suspended` ou `rejected` n'obtient aucun rôle,
    // donc aucune permission. C'est la porte d'entrée de tout le reste.
    function isActive() {
      return isSignedIn() && claims().status == 'active';
    }

    function role() {
      return isActive() ? claims().role : 'none';
    }

    function orgId() {
      return isActive() ? claims().orgId : null;
    }

    function isParent() {
      return role() == 'parent';
    }

    function isFcpe() {
      return role() in ['fcpe', 'moderator', 'admin'];
    }

    function isModerator() {
      return role() in ['moderator', 'admin'];
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Vérifie qu'un champ n'est pas modifié lors d'une mise à jour.
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // Champ **facultatif** figé : soit absent des deux côtés, soit présent et
    // identique.
    //
    // `unchanged()` ne convient pas ici, et la raison est la même que pour
    // `isOptionalString` juste en dessous : il lit `resource.data[field]`, ce qui
    // lève « Property … is undefined on object » quand le champ est absent — et
    // une erreur vaut refus.
    //
    // Conséquence concrète sans ce helper : une publication jamais épinglée n'a
    // pas de `pinnedUntil`, et une publication jamais notifiée n'a pas de
    // `notifiedAt`. Leur auteur ne pourrait donc plus corriger sa propre faute de
    // frappe, alors que la règle serait juste sur le papier. C'est le même piège
    // que `parentId` / `replyToId`, mais avec une issue : ces deux-là sont
    // facultatifs *et* modifiables, tandis que ceux-ci sont facultatifs et
    // **doivent rester figés**, ce que ce test exprime exactement.
    function unchangedOptional(field) {
      return (!(field in request.resource.data) && !(field in resource.data))
        || (field in request.resource.data
          && field in resource.data
          && request.resource.data[field] == resource.data[field]);
    }

    // Vérifie qu'un champ est absent, ou identique à la valeur attendue.
    function keeps(field, value) {
      return !(field in request.resource.data) || request.resource.data[field] == value;
    }

    function isNonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // Champ facultatif : absent, ou une chaîne d'au plus `maxLength`.
    //
    // Le test de présence est indispensable, et `keeps` juste au-dessus en
    // donne le motif. Écrire `d.linkUrl` directement lève « Property linkUrl is
    // undefined on object » quand le champ est absent — et une erreur vaut
    // refus. Une publication sans lien externe serait donc systématiquement
    // rejetée, alors que `linkUrl` est facultatif dans le modèle.
    //
    // La forme précédente, `!(value is string) || …`, ne pouvait pas être
    // corrigée en gardant `value` : sans le nom du champ, la présence est
    // indécidable. Elle acceptait de surcroît n'importe quelle valeur non
    // textuelle, un nombre par exemple.
    function isOptionalString(field, maxLength) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
          && request.resource.data[field].size() <= maxLength);
    }

    // Contenu publié par la FCPE : lecture pour tout membre actif de
    // l'organisation, écriture réservée aux rôles FCPE et supérieurs.
    function canReadOrgContent() {
      return isActive() && resource.data.orgId == orgId();
    }

    // =========================================================================
    //  Organisations, écoles, classes
    // =========================================================================

    match /organizations/{organizationId} {
      // La liste des organisations n'est pas sensible, mais elle n'est pas
      // publique pour autant : il faut être connecté.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /schools/{schoolId} {
      // Lecture nécessaire dès l'inscription : le formulaire doit proposer
      // les établissements. Elle reste donc ouverte aux comptes `pending`.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================================================================
    //  Utilisateurs
    // =========================================================================

    match /users/{uid} {

      // Un utilisateur lit son propre profil, même en attente de validation :
      // c'est ce qui lui permet de compléter ses informations et de voir où en
      // est sa demande.
      //
      // Les autres lectures exigent un rôle habilité (`user.read.any`), **et
      // restent dans l'organisation du lecteur**.
      //
      // La contrainte d'organisation n'est pas décorative, et son absence ne se
      // voyait pas dans les lectures unitaires. Une règle qui ne référence
      // aucun champ du document est satisfaite par Firestore pour **n'importe
      // quelle** requête : sans `resource.data.orgId`, un membre de la FCPE
      // pouvait donc lister la collection entière — les noms, adresses et
      // numéros des parents de toutes les organisations. Vérifié par un test
      // qui échouait, et non déduit.
      //
      // `isFcpe()` inclut déjà `moderator` et `admin`, et `role()` vaut 'none'
      // tant que le compte n'est pas actif : la condition précédente
      // (`isActive() && (isFcpe() || isModerator())`) était redondante sur les
      // deux plans.
      allow read: if isSelf(uid) || (isFcpe() && resource.data.orgId == orgId());

      // Création de son propre profil à l'inscription. Le compte arrive en
      // `pending` : toute autre valeur initiale est refusée.
      allow create: if isSelf(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'parent'
        && request.resource.data.id == uid;

      // Mise à jour de son propre profil : les champs sensibles sont figés.
      // Un utilisateur ne peut pas s'attribuer un rôle ni s'activer lui-même.
      allow update: if isSelf(uid)
        && unchanged('role')
        && unchanged('status')
        && unchanged('orgId')
        && unchanged('orgIds')
        && unchanged('audienceKeys')
        && unchanged('email')
        && unchanged('createdAt');

      // La validation, la suspension et le changement de rôle passent
      // obligatoirement par une Cloud Function (Admin SDK) : elles touchent
      // aux Custom Claims, que le client ne peut pas écrire.
      allow delete: if isSelf(uid) || isAdmin();

      // --- Enfants -----------------------------------------------------------
      match /children/{childId} {
        // Le parent gère lui-même son rattachement, quel que soit le statut de
        // son compte — et notamment pendant l'attente de validation.
        //
        // C'est une nécessité du parcours d'inscription, pas une commodité :
        // le formulaire exige au moins un enfant, et il est rempli par un
        // compte encore `pending`. Exiger `isActive()` ici rendrait
        // l'inscription impossible.
        //
        // Restreindre au propriétaire suffit : la donnée la plus sensible du
        // système n'est lisible que par lui (et par l'administration, en
        // lecture seule, pour traiter une demande).
        allow read, write: if isSelf(uid);

        // L'administration peut consulter le rattachement pour traiter une
        // demande, mais jamais le modifier à la place du parent.
        allow read: if isActive() && isModerator();
      }

      // --- Jetons de notification -------------------------------------------
      match /tokens/{tokenId} {
        // Aucune lecture côté client, y compris par le propriétaire : un jeton
        // push permet d'envoyer des notifications à un appareil. Seules les
        // Cloud Functions y accèdent.
        allow read: if false;
        allow write: if isSelf(uid);
      }

      // --- Données internes (compteurs anti-spam) ---------------------------
      match /private/{documentId} {
        // Invisibles au client. Écrites par les Cloud Functions.
        allow read, write: if false;
      }
    }

    // =========================================================================
    //  Jetons d'appareil (index d'envoi)
    // =========================================================================

    match /deviceTokens/{token} {
      // Lecture réservée au serveur : l'index complet des appareils de tous
      // les parents ne doit jamais être accessible depuis un client.
      allow read: if false;

      // L'identifiant du document **est** le jeton : l'enregistrement est
      // idempotent, et un même appareil partagé entre deux comptes met à jour
      // `uid` au lieu de créer un doublon.
      //
      // `orgId` est vérifié parce que le serveur choisit les destinataires
      // d'une notification en le lisant : un jeton qui déclare une autre
      // organisation recevrait les notifications de celle-ci.
      //
      // `audienceKeys` et `disabledCategories` sont **vides** à la création,
      // et c'est le point qui compte.
      //
      // `audienceKeys` n'est pas une préférence mais une **autorisation** : le
      // serveur décide qui reçoit quoi en le lisant. Déclaré par le client, il
      // permettrait à un parent de s'abonner à l'audience de la FCPE ou à la
      // classe d'un autre — et les règles ne peuvent pas vérifier une clé
      // `class:` ou `level:`, faute de pouvoir lire les enfants de l'appelant.
      //
      // `disabledCategories` est inoffensif en soi, mais c'est une préférence
      // posée par **utilisateur** et recopiée par **appareil**. Le client ne
      // peut atteindre que l'appareil courant : s'il en était propriétaire, les
      // autres appareils du même parent divergeraient, et l'écran de
      // préférences afficherait l'inverse de ce qui se passe sur la tablette.
      //
      // Les deux champs sont donc écrits par la Cloud Function qui enregistre
      // l'appareil, jamais par le client.
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.orgId == orgId()
        && request.resource.data.token == token
        && request.resource.data.audienceKeys == []
        && request.resource.data.disabledCategories == [];

      // `unchanged(…)` interdit au client de réécrire ce que le serveur a
      // posé. Le client met à jour par `update()`, jamais par `set()` : un
      // `set()` renverrait ces champs à vide et effacerait le travail du
      // serveur — ce que ces clauses refusent, précisément.
      //
      // `enabled` reste libre : c'est l'interrupteur de cet appareil-ci, et il
      // n'appartient qu'à lui.
      //
      // `resource.data.orgId == orgId()` : un jeton ne change pas
      // d'organisation. Les deux comparaisons encadrent le champ — celui qu'on
      // écrit, et celui qu'on remplace — ce qui le rend immuable en pratique.
      // Sans la seconde, un parent du groupe B reprenait un jeton du groupe A
      // en réécrivant `orgId` : le document franchissait la frontière, et
      // l'appareil du groupe A cessait de recevoir ses propres notifications.
      // `orgId` est le seul champ qui rattache un jeton à un groupe ; c'était
      // aussi le seul que le client pouvait réécrire.
      //
      // Conséquence, aujourd'hui théorique : un compte dont l'organisation
      // changerait ne pourrait plus mettre à jour ses jetons, et devrait les
      // supprimer puis les recréer. Aucun chemin de code n'écrit `orgId` sur un
      // profil — les règles le figent pour le client, et les fonctions
      // appelables ne font que le lire —, mais si un tel chemin apparaissait,
      // la suppression resterait possible : elle ne dépend volontairement pas
      // de l'organisation.
      allow update: if isActive()
        && request.resource.data.uid == request.auth.uid
        && resource.data.orgId == orgId()
        && request.resource.data.orgId == orgId()
        && request.resource.data.token == token
        && unchanged('createdAt')
        && (
          // Le porteur ne change pas : le client ne touche qu'à ce qui lui
          // appartient en propre — `enabled`, `lastUsedAt`, `appVersion`.
          (
            resource.data.uid == request.auth.uid
            && unchanged('audienceKeys')
            && unchanged('disabledCategories')
          )
          // Le porteur change : l'appareil repart de zéro. Les deux champs
          // déduits par le serveur sont exigés **séparément**, car effacer
          // l'audience en gardant les préférences laisserait le nouveau porteur
          // avec les catégories désactivées de l'ancien, et l'écran de
          // préférences afficherait l'inverse de ce que l'appareil applique.
          || (
            resource.data.uid != request.auth.uid
            && request.resource.data.audienceKeys == []
            && request.resource.data.disabledCategories == []
          )
        );

      allow delete: if isActive() && resource.data.uid == request.auth.uid;
    }

    // =========================================================================
    //  Tickets de notification (relecture des reçus)
    // =========================================================================

    match /pushTickets/{ticketId} {
      // Aucun accès client, dans aucun sens.
      //
      // Ce document existe pour une seule raison : un reçu Expo désigne un
      // **ticket**, jamais un jeton, donc relire les reçus ne suffit pas à
      // savoir quel appareil est mort. Le ticket est le seul endroit où
      // l'identifiant et le jeton se rencontrent, et il les garde le temps que
      // les reçus soient lisibles — vingt-quatre heures.
      //
      // C'est aussi pourquoi il n'est pas lisible : il contient un jeton
      // d'appareil. Le mettre dans `notifications`, que la FCPE lit, aurait
      // exposé l'index des appareils que la règle de `deviceTokens` protège
      // déjà — la porte de service aurait remplacé la porte d'entrée.
      allow read, write: if false;
    }

    // =========================================================================
    //  Lots de discussion en attente d'annonce
    // =========================================================================

    match /channelDigests/{channelId} {
      // Aucun accès client, dans aucun sens.
      //
      // Ce document est l'état du regroupement des messages d'un canal : la
      // liste des messages en attente d'être annoncés, et l'instant où ils le
      // seront. Il ne contient rien que le client ne puisse déjà lire — les
      // messages sont dans une sous-collection qu'il peut parcourir — mais
      // c'est un **état de service**, et il est le seul endroit où « ce qui a
      // déjà été annoncé » est écrit. Le laisser modifiable permettrait
      // d'annoncer un lot qui n'existe pas, ou de faire taire celui qui existe
      // en repoussant sa fenêtre.
      allow read, write: if false;
    }

    // =========================================================================
    //  Publications et commentaires
    // =========================================================================

    match /posts/{postId} {

      function validPost() {
        let d = request.resource.data;
        return isNonEmptyString(d.title, 140)
          && isNonEmptyString(d.body, 8000)
          && d.category in [
            'information', 'urgent', 'cantine', 'periscolaire', 'travaux',
            'sortie_scolaire', 'fcpe', 'mairie', 'evenement', 'conseil_ecole', 'autre'
          ]
          && d.audience is map
          && d.audienceKeys is list
          && d.audienceKeys.size() > 0
          && d.audienceKeys.size() <= 5
          // `attachments` et `authorName` sont affichés tels quels par
          // l'application : un client hostile peut écrire une chaîne là où le
          // modèle attend une liste, ou un nom vide. Ce n'est pas une frontière
          // de confidentialité, mais c'est une donnée qu'on relit, donc elle est
          // bornée ici plutôt que défendue à l'affichage.
          && d.attachments is list
          && d.attachments.size() <= 5
          && isNonEmptyString(d.authorName, 60)
          && d.status in ['draft', 'published']
          && d.authorId == request.auth.uid
          && d.orgId == orgId()
          // `commentsEnabled` est obligatoire dans le modèle : l'exiger ici
          // garantit qu'une publication porte toujours la décision, plutôt que
          // de laisser la règle des commentaires interpréter une absence.
          && d.commentsEnabled is bool
          // `pinned` est obligatoire dans le modèle (`Post.pinned: boolean`), et
          // c'est ce qui permet de le figer sans risque plus bas : le figer sur
          // un champ absent lèverait une erreur, donc refuserait toute
          // modification légitime.
          && d.pinned is bool
          // Les compteurs ne sont jamais fixés par le client : ils sont
          // maintenus par les Cloud Functions.
          && d.stats.commentCount is int
          && d.stats.commentCount >= 0
          && isOptionalString('linkUrl', 2048);
      }

      // Lecture d'une publication précise.
      //
      // Plus large que la requête, et c'est nécessaire : l'auteur doit pouvoir
      // rouvrir son brouillon dans l'éditeur, et la modération doit pouvoir
      // relire un contenu masqué pour revenir sur son masquage. Sans cela un
      // brouillon serait écrit puis définitivement invisible — y compris pour
      // celui qui vient de l'écrire.
      //
      // Élargir `get` ne découvre rien : les trois cas sont « c'est publié »,
      // « j'en suis l'auteur », « je modère ».
      allow get: if isActive()
        && resource.data.orgId == orgId()
        && (resource.data.status == 'published'
          || resource.data.authorId == request.auth.uid
          || isModerator());

      // Requête : seule une règle **démontrable à partir des contraintes de la
      // requête** est acceptée (voir l'en-tête de ce fichier). `status ==
      // 'published'` l'est ; une disjonction avec `isModerator()` ne l'est pas,
      // car Firestore ne peut pas la prouver à partir d'un `where`.
      //
      // Conséquence assumée : le fil et l'écran d'administration listent les
      // publications publiées, et un brouillon s'ouvre par son identifiant, pas
      // par une liste.
      allow list: if canReadOrgContent() && resource.data.status == 'published';

      // Seule la FCPE publie dans le fil d'actualité. Un parent s'exprime via
      // les discussions, les signalements et les sondages.
      //
      // Deux conditions de plus qu'une simple validation de forme, et toutes
      // deux corrigent une restriction qui n'existait que dans l'interface :
      //
      //  - `pinned` ne peut pas être vrai à la création, sauf pour un rôle de
      //    modération. `post.pin` est réservé à `moderator` / `admin` dans la
      //    matrice de permissions, mais rien ne l'appliquait : il suffisait de
      //    passer `pinned: true` pour épingler sa publication. Or un client
      //    hostile n'utilise pas notre interface.
      //  - `authorRole` doit correspondre au rôle réel. Le fil affiche un badge
      //    à partir de ce champ, donc le laisser libre permettrait à un membre
      //    de la FCPE de se présenter comme administrateur.
      //
      // Cette seconde vérification est ici, et non dans `validPost()`, parce
      // qu'elle compare une valeur écrite au jeton de l'appelant : à la mise à
      // jour, `authorRole` est figé, et un membre promu entre-temps doit pouvoir
      // corriger ses anciennes publications.
      allow create: if isFcpe() && validPost()
        && request.resource.data.authorRole == role()
        && (request.resource.data.pinned == false || isModerator());

      // -----------------------------------------------------------------------
      //  Mise à jour — deux branches, un seul motif
      // -----------------------------------------------------------------------
      //
      // Une mise à jour est évaluée sur le **document entier** après fusion, et
      // non sur le seul champ modifié : une règle qui n'exige rien autorise la
      // réécriture de tout. Chaque branche doit donc figer explicitement ce
      // qu'elle n'a pas vocation à changer.
      //
      // Deux acteurs aux besoins disjoints :
      //   - l'auteur corrige son texte — il ne touche ni à son identité, ni aux
      //     compteurs, ni à l'épinglage ;
      //   - la modération épingle, masque ou archive — elle ne réécrit jamais le
      //     texte sous le nom de son auteur.
      //
      // C'est le motif déjà appliqué aux commentaires et aux messages, à une
      // différence près : `validPost()` exige `d.authorId == request.auth.uid`,
      // donc il ne peut pas servir à la branche de modération, qui agit par
      // définition sur la publication d'un autre. D'où `validModerationEdit()`,
      // qui ne revalide pas le contenu mais le fige — figer est plus fort que
      // revalider, puisque la valeur figée a déjà été validée à la création.
      //
      // La version précédente (`isFcpe() && validPost() && unchanged('orgId')
      // && unchanged('authorId')`) souffrait des deux côtés à la fois : un
      // modérateur ne pouvait pas épingler la publication d'un autre, et un
      // membre de la FCPE pouvait épingler la sienne.

      // Branche 1 — l'auteur corrige son texte.
      //
      // `stats` est figé : `validPost()` n'exige qu'un entier positif, donc sans
      // ce gel un auteur pouvait écrire `commentCount: 9999` et se donner
      // l'apparence d'une publication très commentée.
      function validOwnPostEdit() {
        return isFcpe()
          && validPost()
          && unchanged('authorId')
          && unchanged('authorName')
          && unchanged('authorRole')
          && unchanged('orgId')
          && unchanged('createdAt')
          && unchanged('publishedAt')
          && unchanged('stats')
          && unchanged('pinned')
          && unchangedOptional('pinnedUntil')
          && unchangedOptional('notifiedAt');
      }

      // Branche 2 — la modération ne touche qu'à l'épinglage et au statut.
      //
      // Tout le reste est figé, y compris `title`, `body` et `attachments` : un
      // modérateur masque, il ne réécrit pas.
      //
      // Le statut est borné à `published` / `hidden` / `archived`. Retirer
      // définitivement une publication reste une décision d'administrateur
      // (`allow delete`), et `draft` n'a pas de sens pour quelqu'un qui n'est
      // pas l'auteur : une rétractation est un masquage, pas un retour au
      // brouillon.
      function validModerationEdit() {
        let d = request.resource.data;
        return unchanged('title')
          && unchanged('body')
          && unchanged('category')
          && unchanged('audience')
          && unchanged('audienceKeys')
          && unchanged('attachments')
          && unchangedOptional('linkUrl')
          && unchanged('authorId')
          && unchanged('authorName')
          && unchanged('authorRole')
          && unchanged('commentsEnabled')
          && unchanged('orgId')
          && unchanged('createdAt')
          && unchanged('publishedAt')
          && unchanged('stats')
          && unchangedOptional('notifiedAt')
          && d.pinned is bool
          && d.status in ['published', 'hidden', 'archived'];
      }

      allow update: if (resource.data.authorId == request.auth.uid && validOwnPostEdit())
        || (isModerator() && validModerationEdit());

      // Suppression réservée à l'administrateur : masquer est réversible et
      // traçable, supprimer ne l'est pas.
      allow delete: if isAdmin();

      match /comments/{commentId} {

        function validComment() {
          let d = request.resource.data;
          return isNonEmptyString(d.body, 2000)
            && d.authorId == request.auth.uid
            && d.postId == postId
            && d.status == 'visible'
            && d.reportCount == 0;
        }

        // Une mise à jour est validée sur le **document entier**, pas sur le
        // seul champ modifié : Firestore évalue `request.resource.data`, donc
        // une règle qui n'exige rien autorise la réécriture de tout le
        // document. C'est précisément ce que faisait la version précédente
        // (`isActive() && authorId == uid`), et un client hostile n'a pas
        // besoin de notre code pour écrire : il peut appeler Firestore
        // directement. Un auteur pouvait donc changer `authorId` (usurpation,
        // puisque `authorName` est dénormalisé et affiché), `authorRole` (se
        // faire passer pour un membre de la FCPE ou un administrateur),
        // `postId` (désynchronisation avec le chemin parent), `reportCount`
        // (dissimulation d'un signalement) ou `reactions` (falsification des
        // compteurs). Les champs d'identité et de comptage sont désormais figés.
        function validOwnCommentEdit() {
          let d = request.resource.data;
          return isNonEmptyString(d.body, 2000)
            && d.authorId == request.auth.uid
            && d.postId == postId
            && d.status in ['visible', 'deleted']
            && unchanged('authorName')
            && unchanged('authorRole')
            && unchanged('reportCount')
            && unchanged('replyCount')
            && unchanged('reactions')
            && unchanged('createdAt');
        }

        // Le modérateur masque, il ne réécrit pas : son rôle est de rendre un
        // contenu invisible, pas d'en changer le texte sous le nom de son
        // auteur. Sans cette contrainte, `isModerator()` seul autorisait un
        // modérateur à réécrire le corps d'un commentaire, ce que le commentaire
        // d'origine annonçait déjà comme interdit (« masquage uniquement »)
        // sans que la règle l'applique.
        //
        // Le statut reste borné à `visible` / `hidden` : retirer définitivement
        // un contenu est une décision d'administrateur (`allow delete`), et le
        // masquage est la seule opération réversible offerte à la modération.
        function validModerationEdit() {
          return unchanged('body')
            && unchanged('authorId')
            && unchanged('authorName')
            && unchanged('authorRole')
            && unchanged('postId')
            && unchanged('reportCount')
            && unchanged('replyCount')
            && unchanged('createdAt')
            && request.resource.data.status in ['visible', 'hidden'];
        }

        // Un commentaire n'est lisible que si la publication parente l'est.
        allow read: if isActive() && resource.data.status == 'visible';

        // Une publication fermée aux commentaires n'en reçoit pas, et une
        // publication non publiée non plus.
        //
        // Sans cette vérification, `commentsEnabled` serait purement indicatif :
        // l'interface masque le champ de saisie, mais un client hostile n'a pas
        // besoin de notre interface pour écrire dans Firestore. Fermer les
        // commentaires est une décision de la FCPE : elle doit être une règle,
        // pas une convention d'affichage.
        //
        // `get()` lit le document parent avec un accès total — la règle de
        // lecture de `posts` ne s'applique pas ici. Un document absent fait
        // échouer l'accès à `.data`, donc l'écriture est refusée : échec fermé.
        // Coût : une lecture par création de commentaire (voir
        // `docs/06-couts.md`).
        //
        // La vérification ne porte que sur `create` : une fois les commentaires
        // fermés, leur auteur doit pouvoir continuer à retirer le sien.
        function parentAcceptsComments() {
          let post = get(/databases/$(database)/documents/posts/$(postId)).data;
          return post.status == 'published' && post.commentsEnabled == true;
        }

        allow create: if isActive() && parentAcceptsComments() && validComment();

        // Auteur : modifier son corps, ou le retirer (`deleted`).
        // Modérateur : masquer, et remettre en ligne.
        allow update: if (isActive()
            && resource.data.authorId == request.auth.uid
            && validOwnCommentEdit())
          || (isModerator() && validModerationEdit());

        allow delete: if isAdmin();

        // Réactions : même motif que `votes/{voterKey}` — l'identifiant du
        // document est l'UID du réacteur, donc une double réaction est
        // impossible par construction, et non par du code applicatif.
        match /reactions/{uid} {

          // La liste des emojis est en dur, et doit rester identique à
          // `REACTION_EMOJIS` dans `@fl/shared` : une règle ne peut pas
          // importer de constante TypeScript.
          function validReaction() {
            let d = request.resource.data;
            return d.uid == request.auth.uid
              && d.postId == postId
              && d.commentId == commentId
              && d.emoji in ['👍', '🎉', '🙏', '😮', '😍'];
          }

          // Chacun ne lit que sa propre réaction : c'est ce qui suffit à
          // afficher l'état du bouton. Le décompte vient du commentaire.
          allow read: if isActive() && uid == request.auth.uid;

          // `validReaction` épingle l'identité à la fois sur l'UID du porteur et
          // sur le chemin parent : inutile d'y ajouter des `unchanged`.
          allow create, update: if isActive() && uid == request.auth.uid && validReaction();

          // Retirer sa réaction est légitime ; le document disparaît et la
          // Cloud Function recalcule le décompte.
          allow delete: if isActive() && resource.data.uid == request.auth.uid;
        }
      }
    }

    // =========================================================================
    //  Discussions
    // =========================================================================

    match /channels/{channelId} {

      // Les canaux de type `fcpe` sont invisibles pour les parents : c'est une
      // frontière dure, contrôlée par le rôle et non par la requête.
      allow read: if isActive()
        && resource.data.orgId == orgId()
        && (resource.data.type != 'fcpe' || isFcpe());

      allow create, update: if isModerator();
      allow delete: if isAdmin();

      match /messages/{messageId} {

        function validMessage() {
          let d = request.resource.data;
          return isNonEmptyString(d.body, 2000)
            && d.authorId == request.auth.uid
            && d.channelId == channelId
            && d.status == 'visible'
            && d.reportCount == 0;
        }

        // Même correctif que pour les commentaires, et pour la même raison :
        // une mise à jour est validée sur le **document entier** après fusion,
        // donc une règle qui n'exige rien autorise la réécriture de tout. La
        // version précédente (`authorId == uid || isModerator()`) laissait un
        // auteur modifier `authorId` (usurpation — `authorName` est dénormalisé
        // et affiché), `authorRole` (se faire passer pour la FCPE), `channelId`
        // (désynchronisation avec le chemin parent), `reportCount`
        // (dissimulation d'un signalement) ou `reactions`.
        //
        // `replyToId` et `replyToPreview` sont facultatifs et ne sont donc pas
        // couverts : `unchanged()` lève une erreur sur un champ absent, et une
        // erreur vaut refus — tout message sans réponse serait rejeté. Un auteur
        // peut donc encore rattacher son message à un autre. Ce n'est pas une
        // frontière de confidentialité (même canal, même audience), seulement un
        // défaut d'intégrité, assumé tant que la messagerie n'est pas écrite.
        function validOwnMessageEdit() {
          let d = request.resource.data;
          return isNonEmptyString(d.body, 2000)
            && d.authorId == request.auth.uid
            && d.channelId == channelId
            && d.status in ['visible', 'deleted']
            && unchanged('authorName')
            && unchanged('authorRole')
            && unchanged('attachments')
            && unchanged('reactions')
            && unchanged('reportCount')
            && unchanged('createdAt');
        }

        // Modération : masquer, jamais réécrire. Le corps et l'auteur sont figés.
        function validModerationEdit() {
          return unchanged('body')
            && unchanged('authorId')
            && unchanged('authorName')
            && unchanged('authorRole')
            && unchanged('channelId')
            && unchanged('attachments')
            && unchanged('reportCount')
            && unchanged('createdAt')
            && request.resource.data.status in ['visible', 'hidden'];
        }

        allow read: if isActive() && resource.data.status == 'visible';
        allow create: if isActive() && validMessage();
        allow update: if (isActive()
            && resource.data.authorId == request.auth.uid
            && validOwnMessageEdit())
          || (isModerator() && validModerationEdit());
        allow delete: if isAdmin();
      }
    }

    // =========================================================================
    //  Sondages
    // =========================================================================

    match /polls/{pollId} {

      function validPoll() {
        let d = request.resource.data;
        return isNonEmptyString(d.question, 200)
          && d.options is list
          && d.options.size() >= 2
          && d.options.size() <= 10
          && d.status in ['draft', 'open', 'closed']
          && d.audienceKeys is list
          && d.audienceKeys.size() > 0
          && d.orgId == orgId();
      }

      allow read: if canReadOrgContent() && resource.data.status in ['open', 'closed'];

      // Création et mise à jour sont **séparées**, et ce n'est pas une
      // coquetterie de style : `unchanged()` lit `resource.data[field]`, qui
      // n'existe pas sur une création. Une règle qui couvrait les deux
      // refusait donc toute création de sondage, avec une erreur d'évaluation
      // — « Null value error » — que rien ne signalait : aucun test ne créait
      // de sondage, et les deux tests qui s'en approchaient attendaient un
      // **refus**, qu'ils obtenaient pour la mauvaise raison.
      //
      // `validPoll()` ne vérifie pas `authorId` : c'est `isFcpe()` qui décide
      // qui publie, et un membre de la FCPE n'a pas à être l'auteur pour ouvrir
      // un sondage au nom de l'association.
      allow create: if isFcpe() && validPoll();
      allow update: if isFcpe() && validPoll() && unchanged('orgId');
      allow delete: if isAdmin();

      match /votes/{voterKey} {

        // POINT CLÉ : l'identifiant du document de vote est l'UID de
        // l'utilisateur. Le double vote est donc impossible par construction,
        // et non par du code applicatif qui pourrait être contourné.
        //
        // Un utilisateur ne peut lire et écrire que son propre vote.
        allow read: if isActive() && voterKey == request.auth.uid;

        // Ce qu'un vote a le droit d'être se lit dans le **sondage**, jamais
        // dans le vote : le client est hostile, et il peut écrire ce qu'il veut
        // dans son propre document — y compris prétendre que le sondage
        // accepte plusieurs réponses. Les conditions ci-dessous sont donc
        // lues dans le document parent, et les règles en sont la seule
        // barrière ; le dépôt client ne fait que produire un message lisible.
        //
        // `exists()` précède `get()` : sans lui, un sondage inexistant ferait
        // échouer l'évaluation sur un accès à `null` — un refus, donc, mais
        // par accident, avec un message qui ne nomme aucune clause. C'est
        // exactement la forme du défaut qui rendait toute création de sondage
        // impossible. Firestore met les deux accès au même chemin en cache.
        function sondageExiste() {
          return exists(/databases/$(database)/documents/polls/$(pollId));
        }

        function sondage() {
          return get(/databases/$(database)/documents/polls/$(pollId)).data;
        }

        // Un vote n'a de sens que sur un sondage **ouvert**, et seulement dans
        // l'organisation du votant. Sans la seconde condition, connaître un
        // identifiant de sondage suffisait à voter dans le groupe scolaire
        // voisin : la lecture était cloisonnée, l'écriture ne l'était pas.
        //
        // Un sondage `closed` est refusé comme un `draft` : accepter un vote
        // après la clôture reviendrait à laisser le résultat bouger sous les
        // yeux de ceux qui l'ont lu.
        function sondageOuvert() {
          return sondage().status == 'open' && sondage().orgId == orgId();
        }

        // Lire un champ **absent** dans une règle ne rend pas `false` : cela
        // lève, et le refus qui en résulte ne nomme aucune clause. Ces trois
        // accesseurs existent pour cela — un sondage écrit sans ces champs
        // serait sinon **invotable**, sans que rien ne le dise.
        //
        // Ce n'est pas une hypothèse : deux tests de refus étaient verts pour
        // cette raison, et non pour la clause qu'ils visaient. C'est le banc de
        // mutation qui l'a mis au jour, en montrant que retirer la clause de
        // statut ne faisait pas tomber le test du brouillon.
        //
        // Le repli est **fermé** pour `allowMultiple` et `anonymous`, comme le
        // défaut du schéma (`false`). Pour `allowChangeVote`, le schéma dit
        // `true` : la règle, elle, exige le champ pour autoriser une
        // modification. Une permission ne s'ouvre pas par omission — et un
        // sondage créé par `createPoll` porte toujours les trois champs.
        function choixMultiple() {
          return 'allowMultiple' in sondage() && sondage().allowMultiple == true;
        }

        function sondageAnonyme() {
          return 'anonymous' in sondage() && sondage().anonymous == true;
        }

        function voteModifiable() {
          return 'allowChangeVote' in sondage() && sondage().allowChangeVote == true;
        }

        function choixValide() {
          let d = request.resource.data;
          return d.pollId == pollId
            && d.optionIds is list
            && d.optionIds.size() > 0
            && d.optionIds.size() <= 10
            // Une même réponse cochée deux fois ne compte pas deux fois. Le
            // décompte serveur ramène déjà la liste à un ensemble ; le refuser
            // ici évite d'écrire un vote qui ne veut rien dire.
            && d.optionIds.toSet().size() == d.optionIds.size()
            // Un sondage dont la question appelle une seule réponse et qui en
            // accepte trois n'est pas un sondage, c'est un scrutin faussé.
            && (choixMultiple() || d.optionIds.size() == 1);
        }

        // L'anonymat se vérifie ici, et non dans le client. `Poll.anonymous`
        // promet qu'un vote anonyme ne porte aucun `uid` ; une promesse que
        // les règles ne tiennent pas n'est pas tenue. Le document reste
        // rattachable à la personne par son identifiant — c'est ce qui rend le
        // double vote impossible — mais aucun champ ne la nomme.
        //
        // Écrit en deux disjonctions plutôt qu'en ternaire : `&&` court-circuite
        // à coup sûr, ce qui garantit que `d.uid` n'est jamais lu sur un
        // sondage anonyme — où le champ est absent, et où sa lecture ferait
        // échouer l'évaluation. Un ternaire n'offre pas cette garantie.
        function votantValide() {
          let d = request.resource.data;
          return (sondageAnonyme() && !('uid' in d))
            || (!sondageAnonyme() && 'uid' in d && d.uid == request.auth.uid);
        }

        allow create: if isActive()
          && voterKey == request.auth.uid
          && sondageExiste()
          && sondageOuvert()
          && choixValide()
          && votantValide();

        // Modifier son vote est une décision du **sondage**, et elle s'y lit :
        // `allowChangeVote` était déclaré dans le modèle et n'était lu nulle
        // part. Les deux clauses restent séparées, comme sur le sondage
        // lui-même — mais ici parce qu'elles ne disent pas la même chose, et
        // non parce qu'une fonction y lirait un champ absent.
        allow update: if isActive()
          && voterKey == request.auth.uid
          && sondageExiste()
          && sondageOuvert()
          && voteModifiable()
          && choixValide()
          && votantValide();

        // Même un administrateur ne peut pas supprimer un vote : cela
        // fausserait les résultats sans laisser de trace.
        allow delete: if false;
      }
    }

    // =========================================================================
    //  Résultats de sondage — lisibles selon `resultsVisibility`
    // =========================================================================

    match /pollResults/{pollId} {

      // Le document est **hors** du sondage, et c'est une décision de sécurité.
      // `polls/{pollId}` est lisible par tout parent de l'organisation — c'est
      // ce qui permet de poser la question avant d'y répondre — donc y écrire
      // les totaux les publierait à tous, quel que soit `resultsVisibility`.
      //
      // Une règle de lecture ne filtre pas des champs : elle ouvre ou ferme un
      // document entier. Déplacer les totaux est la seule façon d'honorer la
      // promesse ; les masquer à l'écran ne l'honorerait pas.
      function sondage() {
        return get(/databases/$(database)/documents/polls/$(pollId)).data;
      }

      // La visibilité se lit **dans le sondage**, jamais dans une copie posée
      // sur ce document : la FCPE peut resserrer `resultsVisibility` après
      // coup, et une copie garderait l'ancienne valeur — les résultats
      // continueraient d'être publiés en silence.
      //
      // Le repli est **fermé**, sur la plus restrictive des trois valeurs :
      // lire un champ absent ne rend pas `false`, cela lève, et le refus qui en
      // résulte ne nomme aucune clause. Le défaut du schéma, lui, est
      // `after_vote` — mais une **permission** ne s'ouvre pas par omission.
      function visibilite() {
        return 'resultsVisibility' in sondage() ? sondage().resultsVisibility : 'after_end';
      }

      function aVote() {
        return exists(
          /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid)
        );
      }

      // Échelle **emboîtée** : `always` ⊃ `after_vote` ⊃ `after_end`.
      //
      //   - `always`     : dès que le sondage est publié ;
      //   - `after_vote` : dès qu'on a voté, et pour **tous** une fois clos ;
      //   - `after_end`  : à la clôture seulement.
      //
      // Fermer un sondage publie donc ses résultats à tout le monde, y compris
      // à ceux qui n'ont pas voté — c'est ce que veut dire `after_end`, qui
      // sans cela serait identique à « jamais ».
      //
      // Un brouillon n'a pas de résultats lisibles : personne ne l'a voté, et
      // le publier révélerait la question avant sa publication.
      function resultatsVisibles() {
        let s = sondage();
        return s.orgId == orgId()
          && s.status in ['open', 'closed']
          && (visibilite() == 'always' || s.status == 'closed' || aVote());
      }

      // La FCPE voit toujours : c'est elle qui administre le sondage et qui
      // doit pouvoir en suivre le décompte avant de le clore. Même frontière
      // que la création — `isFcpe()` —, et la comparaison d'organisation est
      // exigée dans les **deux** branches.
      //
      // Un document de résultats **absent** se lit comme absent, et non comme
      // interdit : c'est le cas d'un sondage que personne n'a encore voté — le
      // document n'apparaît qu'au premier vote, puisque le client ne l'écrit
      // jamais. Sans cette branche, la comparaison d'organisation ci-dessous
      // lirait `resource.data` sur un document inexistant, ce qui **lève** : le
      // refus serait alors indistinguable d'un refus de visibilité, et l'écran
      // ne pourrait pas afficher des zéros.
      //
      // La contrepartie est étroite : on apprend qu'un identifiant de sondage
      // n'a pas encore de résultats. Les identifiants sont aléatoires, et les
      // sondages d'une autre organisation ne se listent pas — donc rien à en
      // tirer. Le `||` court-circuite, si bien que `resource.data` n'est lu que
      // sur un document qui existe.
      allow read: if resource == null
        || (resource.data.orgId == orgId()
          && (isFcpe() || (isActive() && resultatsVisibles())));

      // Un seul écrivain : la Cloud Function `onPollVoteWritten`, qui passe par
      // le SDK Admin et ignore ces règles. Aucun client n'écrit un décompte —
      // c'est ce qui rend les résultats infalsifiables, et non la confiance.
      allow write: if false;
    }

    // =========================================================================
    //  Signalements — strictement privés
    // =========================================================================

    match /reports/{reportId} {

      function validReport() {
        let d = request.resource.data;
        return isNonEmptyString(d.title, 140)
          && isNonEmptyString(d.description, 4000)
          && d.category in [
            'cantine', 'securite', 'harcelement', 'periscolaire',
            'locaux', 'enseignement', 'transport', 'autre'
          ]
          && d.authorId == request.auth.uid
          && d.status == 'received'
          && d.visibility == 'private'
          && d.orgId == orgId();
      }

      // FRONTIÈRE DURE : un parent ne lit que ses propres signalements.
      // Aucune requête ne permet de lire ceux des autres.
      //
      // La comparaison d'organisation n'est exigée que sur la branche
      // privilégiée, et c'est délibéré : `authorId == request.auth.uid` porte
      // déjà la frontière, un identifiant d'utilisateur étant unique. Seule la
      // branche `isFcpe()` en manquait — et son absence était invisible, parce
      // qu'une règle qui ne référence aucun champ du document est satisfaite par
      // Firestore pour **n'importe quelle** requête. Un membre de la FCPE
      // pouvait donc lister la collection entière, tous groupes scolaires
      // confondus : les signalements de harcèlement des familles d'une autre
      // association. C'est la collection la plus sensible du système.
      //
      // Restreindre la seule branche concernée évite d'ajouter une contrainte
      // d'`orgId` à la requête du parent, qui n'en a pas besoin et exigerait un
      // index composite de plus.
      allow read: if isActive()
        && (
          resource.data.authorId == request.auth.uid
          || (isFcpe() && resource.data.orgId == orgId())
        );

      allow create: if isActive() && validReport();

      // Seule la FCPE fait évoluer le statut, la visibilité et l'assignation.
      // L'auteur ne peut rien modifier : un signalement est un témoignage,
      // pas un document collaboratif.
      allow update: if isFcpe() && unchanged('authorId') && unchanged('orgId');

      // Un signalement n'est jamais supprimé : il est clos. La conservation
      // est encadrée par la politique de rétention (voir `docs/04-security.md`).
      allow delete: if isAdmin();

      match /replies/{replyId} {

        function validReply() {
          let d = request.resource.data;
          return isNonEmptyString(d.body, 2000)
            && d.authorId == request.auth.uid
            && d.reportId == reportId;
        }

        // Les notes internes ne sont lisibles que par la FCPE.
        allow read: if isActive() && (
          isFcpe() || (resource.data.internal == false)
        );

        // Seule la FCPE répond. Un parent suit l'avancement, il ne commente
        // pas : cela évite que le fil devienne un espace de discussion.
        allow create: if isFcpe() && validReply();
        allow update: if isFcpe() && unchanged('authorId') && unchanged('reportId');
        allow delete: if isAdmin();
      }
    }

    // =========================================================================
    //  Sujets collectifs
    // =========================================================================

    match /collectiveIssues/{issueId} {

      allow read: if isActive() && resource.data.orgId == orgId() && resource.data.published == true;
      allow create, update: if isFcpe() && unchanged('orgId');
      allow delete: if isAdmin();

      match /supporters/{uid} {
        // Un parent ne peut exprimer qu'une seule position par sujet :
        // l'identifiant du document est son UID.
        allow read: if isActive();
        allow create, update: if isActive()
          && uid == request.auth.uid
          && request.resource.data.issueId == issueId
          && request.resource.data.value in ['concerned', 'for', 'against'];
        allow delete: if isActive() && uid == request.auth.uid;
      }
    }

    // =========================================================================
    //  Agenda et événements
    // =========================================================================

    match /events/{eventId} {

      function validEvent() {
        let d = request.resource.data;
        return isNonEmptyString(d.title, 140)
          && d.type in [
            'conseil_ecole', 'reunion', 'sortie', 'vacances', 'kermesse',
            'election', 'evenement_fcpe', 'evenement_scolaire', 'autre'
          ]
          && d.audienceKeys is list
          && d.audienceKeys.size() > 0
          && d.orgId == orgId();
      }

      allow read: if canReadOrgContent() && resource.data.status != 'draft';
      allow create, update: if isFcpe() && validEvent() && unchanged('orgId');
      allow delete: if isModerator();

      match /participants/{uid} {
        allow read: if isActive();
        allow create, update: if isActive()
          && uid == request.auth.uid
          && request.resource.data.eventId == eventId
          && request.resource.data.attendance in ['going', 'not_going', 'maybe']
          && request.resource.data.guests is int
          && request.resource.data.guests >= 0
          && request.resource.data.guests <= 10;
        allow delete: if isActive() && uid == request.auth.uid;
      }
    }

    // =========================================================================
    //  Documents
    // =========================================================================

    match /documents/{documentId} {

      // `internal` marque un document réservé à la FCPE : frontière dure,
      // contrôlée par le rôle.
      allow read: if isActive()
        && resource.data.orgId == orgId()
        && (resource.data.internal == false || isFcpe());

      allow create, update: if isFcpe() && unchanged('orgId');
      allow delete: if isModerator();
    }

    // =========================================================================
    //  Conseils d'école
    // =========================================================================

    match /schoolCouncils/{councilId} {

      allow read: if isActive() && resource.data.orgId == orgId();
      allow create, update: if isFcpe() && unchanged('orgId');
      allow delete: if isAdmin();

      match /items/{itemId} {

        // FRONTIÈRE DURE : les points de préparation interne de la FCPE
        // (`visibility == 'fcpe'`) ne sont jamais lisibles par un parent.
        // C'est une condition sur un champ du document, mais elle est
        // démontrable par la requête du client, qui filtre sur `visibility`.
        allow read: if isActive() && (isFcpe() || resource.data.visibility == 'public');

        // Un parent peut proposer une question au conseil d'école.
        allow create: if isActive() && (
          (isFcpe() && request.resource.data.visibility in ['public', 'fcpe'])
          || (!isFcpe() && request.resource.data.visibility == 'public')
        );

        // Un parent ne modifie que sa propre question, et uniquement tant
        // qu'elle n'a pas été traitée.
        allow update: if isFcpe()
          || (isActive()
              && resource.data.authorId == request.auth.uid
              && resource.data.status == 'submitted'
              && unchanged('authorId')
              && unchanged('visibility'));

        allow delete: if isAdmin();
      }
    }

    // =========================================================================
    //  Notifications — journal d'envoi
    // =========================================================================

    match /notifications/{notificationId} {
      // Historique des envois : consultable par la FCPE, écrit par le serveur.
      allow read: if isActive() && resource.data.orgId == orgId() && isFcpe();
      allow create, update, delete: if false;
    }

    // =========================================================================
    //  Modération
    // =========================================================================

    match /moderationReports/{moderationReportId} {

      // Un utilisateur peut signaler un contenu. Il ne peut pas lire la file
      // de modération.
      allow create: if isActive()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.targetType in ['post', 'comment', 'message']
        && request.resource.data.orgId == orgId();

      // Le modérateur ne voit que la file de sa propre organisation. Sans cette
      // comparaison, `isModerator()` seul ne référence aucun champ du document :
      // Firestore satisfaisait donc la règle pour n'importe quelle requête, et
      // un modérateur pouvait lister la file entière, toutes organisations
      // confondues.
      allow read: if isModerator() && resource.data.orgId == orgId();

      // Un modérateur ne peut pas réécrire l'identité du signalement. `orgId`
      // est figé pour la même raison qu'ailleurs, et ici plus encore : la règle
      // de lecture ci-dessus s'appuie dessus, donc pouvoir le réécrire
      // reviendrait à pouvoir déplacer un signalement hors de sa frontière.
      allow update: if isModerator()
        && unchanged('reporterId')
        && unchanged('targetId')
        && unchanged('targetPath')
        && unchanged('orgId')
        && unchanged('createdAt');

      allow delete: if isAdmin();
    }

    // =========================================================================
    //  Journal d'audit — immuable
    // =========================================================================

    match /adminLogs/{logId} {
      // Lecture réservée à l'administrateur.
      allow read: if isAdmin();

      // Écriture réservée au serveur. Aucun client, même administrateur, ne
      // peut écrire ou modifier une entrée : un journal falsifiable n'a
      // aucune valeur en cas de litige.
      allow create, update, delete: if false;
    }

    // =========================================================================
    //  Espace privé FCPE
    // =========================================================================

    match /fcpeTasks/{taskId} {
      // Frontière dure : contrôlée par le rôle, jamais par la requête.
      //
      // La lecture portait sur `request.resource`, qui n'existe **pas** sur une
      // lecture : l'expression lève « Property resource is undefined on object »,
      // et une erreur vaut refus. La collection était donc illisible par tout le
      // monde, FCPE comprise, alors que la règle semblait l'autoriser — un
      // défaut de disponibilité, révélé par un test qui attendait un succès.
      //
      // D'où deux règles distinctes : `resource` décrit ce qui est lu,
      // `request.resource` ce qui est écrit. Les confondre ne compile pas mal —
      // elles échouent silencieusement, en refusant.
      allow read: if isFcpe() && resource.data.orgId == orgId();
      allow create, update: if isFcpe() && request.resource.data.orgId == orgId();
      allow delete: if isFcpe();
    }

    // =========================================================================
    //  Compteurs et raccourcis (documents agrégés)
    // =========================================================================

    match /counters/{counterId} {
      // Lecture par les membres actifs : le tableau de bord de
      // l'administration s'en sert. Écriture serveur uniquement, sinon les
      // chiffres affichés seraient manipulables.
      allow read: if isActive();
      allow write: if false;
    }

    match /highlights/{highlightId} {
      allow read: if isActive();
      allow write: if false;
    }

    // =========================================================================
    //  Refus par défaut
    // =========================================================================
    //
    // Toute collection non mentionnée ci-dessus est inaccessible. C'est
    // volontaire : ajouter une collection sans écrire de règle ne l'expose
    // pas par accident.
    //
    // Firestore applique déjà ce comportement, mais le rappeler ici évite
    // qu'un futur contributeur suppose le contraire.
  }
}
