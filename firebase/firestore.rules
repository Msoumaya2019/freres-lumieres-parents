rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function claim(name, fallback) { return request.auth.token.get(name, fallback); }
    function role() { return claim('role', ''); }
    function status() { return claim('status', ''); }
    function organizationId() { return claim('organizationId', ''); }
    function activeMember() { return signedIn() && status() == 'active' && role() in ['fcpe', 'moderator', 'admin']; }
    function roleIn(roles) { return activeMember() && role() in roles; }
    function sameOrganization(data) { return data != null && data.organizationId == organizationId(); }
    function publicAudience(data) { return data.audience.type in ['all', 'school', 'level', 'class']; }
    function privateMemberAudience(data) { return activeMember() && sameOrganization(data) && data.audience.type == 'fcpe'; }
    function publicPublished(data) { return data.published == true && publicAudience(data); }
    function safePublicCouncil(data) { return !data.keys().hasAny(['internalNotes', 'internalDocumentIds', 'privateNotes']); }

    match /memberProfiles/{memberId} {
      allow create, delete: if false;
      allow read: if signedIn() && sameOrganization(resource.data) && (
        (request.auth.uid == memberId && role() in ['fcpe', 'moderator', 'admin'] && status() in ['pending', 'active', 'suspended', 'rejected']) ||
        roleIn(['admin'])
      );
      allow update: if activeMember() && request.auth.uid == memberId && sameOrganization(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'declaredFunction', 'updatedAt']);
    }
    match /organizations/{id} { allow read: if resource.data.active == true; allow write: if false; }
    match /schools/{id} { allow read: if resource.data.active == true; allow write: if false; }
    match /levels/{id} { allow read: if resource.data.active == true; allow write: if false; }
    match /classes/{id} { allow read: if resource.data.active == true; allow write: if false; }

    match /posts/{id} {
      allow read: if (resource.data.status == 'published' && (publicAudience(resource.data) || privateMemberAudience(resource.data))) || (roleIn(['admin']) && sameOrganization(resource.data));
      allow create: if roleIn(['admin']) && sameOrganization(request.resource.data) && request.resource.data.authorId == request.auth.uid;
      allow update: if roleIn(['admin']) && sameOrganization(resource.data) && sameOrganization(request.resource.data);
      allow delete: if roleIn(['admin']) && sameOrganization(resource.data);
    }
    match /events/{id} { allow read: if publicPublished(resource.data) || (resource.data.published == true && privateMemberAudience(resource.data)) || (roleIn(['admin']) && sameOrganization(resource.data)); allow write: if roleIn(['admin']) && sameOrganization(request.resource.data); }
    match /canteenMenus/{id} { allow read: if resource.data.published == true; allow write: if roleIn(['admin']) && sameOrganization(request.resource.data); }
    match /documents/{id} { allow read: if publicPublished(resource.data) || (resource.data.published == true && privateMemberAudience(resource.data)) || (roleIn(['admin']) && sameOrganization(resource.data)); allow write: if roleIn(['admin']) && sameOrganization(request.resource.data); }
    match /schoolCouncils/{id} { allow read: if safePublicCouncil(resource.data) && (publicPublished(resource.data) || (resource.data.published == true && privateMemberAudience(resource.data)) || (roleIn(['admin']) && sameOrganization(resource.data))); allow write: if roleIn(['admin']) && sameOrganization(request.resource.data) && safePublicCouncil(request.resource.data); }
    match /schoolCouncilPreparations/{id} { allow read: if activeMember() && sameOrganization(resource.data); allow create, update: if activeMember() && sameOrganization(request.resource.data); allow delete: if roleIn(['admin']) && sameOrganization(resource.data); }
    match /polls/{id} { allow read: if publicPublished(resource.data) || (resource.data.published == true && privateMemberAudience(resource.data)) || (roleIn(['admin']) && sameOrganization(resource.data)); allow write: if roleIn(['admin']) && sameOrganization(request.resource.data); }

    // Les votes anonymes et le support sans compte passent uniquement par des Functions.
    match /pollResponses/{id} { allow read, write: if false; }
    match /contactConversations/{id} { allow read, write: if false; }
    match /contactMessages/{id} { allow read, write: if false; }
    match /contactInternalNotes/{id} { allow read, write: if false; }

    match /fcpeChannels/{id} { allow read: if activeMember() && sameOrganization(resource.data); allow write: if roleIn(['moderator', 'admin']) && sameOrganization(request.resource.data); }
    match /fcpeMessages/{id} { allow read: if activeMember() && sameOrganization(resource.data); allow create: if activeMember() && sameOrganization(request.resource.data) && request.resource.data.authorId == request.auth.uid; allow update: if roleIn(['moderator', 'admin']) && sameOrganization(resource.data); allow delete: if false; }
    match /notificationCampaigns/{id} { allow read: if roleIn(['admin']) && sameOrganization(resource.data); allow write: if false; }
    match /adminLogs/{id} { allow read: if roleIn(['admin']) && sameOrganization(resource.data); allow write: if false; }
    match /moderationLogs/{id} { allow read: if roleIn(['moderator', 'admin']) && sameOrganization(resource.data); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
