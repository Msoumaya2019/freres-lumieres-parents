rules_version = '2';

// =============================================================================
//  Règles Firebase Storage — FCPE Frères Lumières
// =============================================================================
//
//  TROIS PRINCIPES
//  ---------------
//  1. **Format restreint** : JPG, PNG, WEBP et PDF uniquement. Aucune vidéo
//     en V1 — c'est la principale source de coûts de stockage et de bande
//     passante incontrôlés.
//  2. **Taille bornée** : 2 Mio pour une image, 10 Mio pour un PDF. La
//     compression est faite côté client AVANT l'envoi (redimensionnement à
//     1600 px, qualité 0,8) ; ces limites sont le filet de sécurité, pas la
//     stratégie principale.
//  3. **Chemins cloisonnés par organisation** : le chemin contient `orgId`,
//     ce qui permet de vérifier l'appartenance sans lire le moindre document
//     Firestore — donc sans coût.
//
//  RAPPEL : une règle Storage ne peut pas compresser un fichier. Sans
//  compression côté client, une photo de 8 Mo serait rejetée et l'utilisateur
//  ne comprendrait pas pourquoi. Les deux mécanismes sont complémentaires.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    //  Helpers
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function claims() {
      return request.auth.token;
    }

    function isActive() {
      return isSignedIn() && claims().status == 'active';
    }

    function role() {
      return isActive() ? claims().role : 'none';
    }

    function orgId() {
      return isActive() ? claims().orgId : null;
    }

    function isFcpe() {
      return role() in ['fcpe', 'moderator', 'admin'];
    }

    function isModerator() {
      return role() in ['moderator', 'admin'];
    }

    function isAdmin() {
      return role() == 'admin';
    }

    // Le chemin doit appartenir à l'organisation de l'utilisateur.
    function inOwnOrg(org) {
      return isActive() && org == orgId();
    }

    function isImage() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function underSize(bytes) {
      return request.resource.size <= bytes;
    }

    // 2 Mio : taille maximale d'une image après compression.
    function validImage() {
      return isImage() && underSize(2 * 1024 * 1024);
    }

    // 10 Mio : taille maximale d'un PDF.
    function validDocument() {
      return isPdf() && underSize(10 * 1024 * 1024);
    }

    // =========================================================================
    //  Pièces jointes des publications — lecture par tous, écriture FCPE
    // =========================================================================

    match /orgs/{org}/posts/{postId}/{fileName} {
      allow read: if inOwnOrg(org);
      allow write: if inOwnOrg(org) && isFcpe() && validImage();
      allow delete: if inOwnOrg(org) && isModerator();
    }

    // =========================================================================
    //  Pièces jointes des messages de discussion
    // =========================================================================

    match /orgs/{org}/channels/{channelId}/{fileName} {
      allow read: if inOwnOrg(org);
      allow write: if inOwnOrg(org) && isActive() && validImage();
      allow delete: if inOwnOrg(org) && isModerator();
    }

    // =========================================================================
    //  Photos jointes à un signalement — STRICTEMENT PRIVÉES
    // =========================================================================
    //
    //  C'est la donnée la plus sensible du système : une photo de cantine ou
    //  de cour de récréation peut contenir des enfants identifiables.
    //
    //  Seuls l'auteur du signalement et la FCPE peuvent y accéder. Le chemin
    //  contient l'identifiant du signalement, ce qui rend la vérification
    //  directe, sans lecture Firestore.

    match /orgs/{org}/reports/{reportId}/{fileName} {
      // Comment identifier l'auteur sans pouvoir lire Firestore depuis une
      // règle Storage ? On s'appuie sur les métadonnées du fichier :
      // le client écrit `authorId` dans `metadata` au moment de l'envoi.
      //
      // Ce n'est pas falsifiable : la règle d'écriture exige que cette
      // métadonnée soit égale à l'UID de la personne connectée. Un parent ne
      // peut donc pas déposer un fichier en se faisant passer pour un autre.
      allow read: if inOwnOrg(org) && (
        isFcpe() || resource.metadata.authorId == request.auth.uid
      );

      allow write: if inOwnOrg(org)
        && isActive()
        && validImage()
        && request.resource.metadata.authorId == request.auth.uid;

      allow delete: if inOwnOrg(org) && isModerator();
    }

    // =========================================================================
    //  Bibliothèque de documents
    // =========================================================================

    match /orgs/{org}/documents/{documentId}/{fileName} {
      // Les documents internes de la FCPE sont rangés sous un préfixe dédié :
      // `internal-`. La vérification est immédiate, sans lecture Firestore.
      allow read: if inOwnOrg(org)
        && (isFcpe() || !fileName.matches('internal-.*'));
      allow write: if inOwnOrg(org) && isFcpe() && (validImage() || validDocument());
      allow delete: if inOwnOrg(org) && isModerator();
    }

    // =========================================================================
    //  Pièces jointes des événements
    // =========================================================================

    match /orgs/{org}/events/{eventId}/{fileName} {
      allow read: if inOwnOrg(org);
      allow write: if inOwnOrg(org) && isFcpe() && (validImage() || validDocument());
      allow delete: if inOwnOrg(org) && isModerator();
    }

    // =========================================================================
    //  Photos de profil
    // =========================================================================
    //
    //  Facultatif en V1. Le chemin contient l'UID : chacun ne peut écrire que
    //  dans son propre dossier.

    match /orgs/{org}/avatars/{uid}/{fileName} {
      allow read: if inOwnOrg(org);
      allow write: if inOwnOrg(org) && isActive() && uid == request.auth.uid && validImage();
      allow delete: if inOwnOrg(org) && (uid == request.auth.uid || isAdmin());
    }

    // =========================================================================
    //  Refus par défaut
    // =========================================================================
    //
    //  Tout chemin non mentionné ci-dessus est inaccessible. Ajouter un
    //  nouveau dossier de stockage sans écrire de règle ne l'expose donc pas
    //  par accident.
  }
}
