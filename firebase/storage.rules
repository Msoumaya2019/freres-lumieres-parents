rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function claim(name, fallback) { return request.auth.token.get(name, fallback); }
    function activeMember() { return request.auth != null && claim('status', '') == 'active' && claim('role', '') in ['fcpe', 'moderator', 'admin']; }
    function admin() { return activeMember() && claim('role', '') == 'admin'; }
    function sameOrganization(data) { return data != null && data.organizationId == claim('organizationId', ''); }
    function publicAudience(data) { return data.audience.type in ['all', 'school', 'level', 'class']; }
    function privateAudience(data) { return activeMember() && sameOrganization(data) && data.audience.type == 'fcpe'; }
    function validAsset() { return request.resource.size <= 10 * 1024 * 1024 && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/(jpeg|png|webp)')); }

    match /posts/{postId}/{fileName} {
      allow read: if firestore.get(/databases/(default)/documents/posts/$(postId)).data.status == 'published' && (publicAudience(firestore.get(/databases/(default)/documents/posts/$(postId)).data) || privateAudience(firestore.get(/databases/(default)/documents/posts/$(postId)).data));
      allow write: if admin() && sameOrganization(firestore.get(/databases/(default)/documents/posts/$(postId)).data) && validAsset();
    }
    match /documents/{documentId}/{fileName} {
      allow read: if firestore.get(/databases/(default)/documents/documents/$(documentId)).data.published == true && (publicAudience(firestore.get(/databases/(default)/documents/documents/$(documentId)).data) || privateAudience(firestore.get(/databases/(default)/documents/documents/$(documentId)).data));
      allow write: if admin() && sameOrganization(firestore.get(/databases/(default)/documents/documents/$(documentId)).data) && validAsset();
    }
    match /canteen/{menuId}/{fileName} {
      allow read: if firestore.get(/databases/(default)/documents/canteenMenus/$(menuId)).data.published == true;
      allow write: if admin() && sameOrganization(firestore.get(/databases/(default)/documents/canteenMenus/$(menuId)).data) && validAsset();
    }
    match /fcpe/{organizationId}/{allPaths=**} { allow read: if activeMember() && organizationId == claim('organizationId', ''); allow write: if activeMember() && claim('role', '') in ['moderator', 'admin'] && organizationId == claim('organizationId', '') && validAsset(); }
    // Une future Function émettra des URL signées après validation du secret.
    match /contact/{allPaths=**} { allow read, write: if false; }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
