# =============================================================================
#  .env.example — modèle de configuration
#  Copier en `.env.local` (mobile/admin) ou `.env` (functions) puis remplir.
#  AUCUNE valeur réelle ne doit être écrite ici : ce fichier est PUBLIC.
# =============================================================================
#
#  RAPPEL CRITIQUE
#  ----------------
#  Les variables préfixées EXPO_PUBLIC_ ou NEXT_PUBLIC_ sont EMBARQUÉES EN CLAIR
#  dans le bundle livré aux utilisateurs (app mobile / navigateur).
#  On peut donc y mettre la configuration Firebase *client* : ces valeurs ne
#  sont pas des secrets, elles sont de toute façon visibles par n'importe qui.
#  La sécurité réelle est assurée par les Security Rules + Cloud Functions.
#
#  En revanche, JAMAIS dans un préfixe public :
#    - une clé privée de compte de service (Firebase Admin SDK)
#    - un token Expo (EXPO_TOKEN), un token Sentry, une clé APNs
#    - un mot de passe, un certificat .p12/.jks, un fichier .mobileprovision
#    - GOOGLE_APPLICATION_CREDENTIALS pointant vers un JSON privé
#
# -----------------------------------------------------------------------------
#  1. APPLICATION MOBILE (Expo) — apps/mobile/.env.local
#     Variables PUBLIQUES (embarquées dans l'app). Récupérées dans
#     Console Firebase > Paramètres du projet > Vos applications > SDK setup.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Identifiant d'application Firebase pour la télémétrie Analytics (optionnel)
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Environnement logique : development | production
EXPO_PUBLIC_APP_ENV=development
# Active le raccordement aux émulateurs Firebase locaux (true/false)
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
# Hôte des émulateurs (utile si l'on teste depuis un téléphone physique)
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
# Organisation servie par cette application, désignée par son slug lisible.
# L'application résout le document correspondant dans `organizations` pour en
# obtenir l'identifiant, utilisé au rattachement des profils. Ce n'est pas une
# valeur de sécurité : un slug erroné ne donne aucun droit, il empêche
# simplement l'inscription en signalant que les données de référence manquent.
EXPO_PUBLIC_DEFAULT_ORG_SLUG=fcpe-montmagny

# -----------------------------------------------------------------------------
#  2. INTERFACE WEB ADMIN (Next.js) — apps/admin/.env.local
#     Variables PUBLIQUES (exposées au navigateur).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1

# -----------------------------------------------------------------------------
#  3. INTERFACE WEB ADMIN — variables SERVEUR (jamais exposées au navigateur)
#     Nécessaires uniquement si l'admin appelle l'Admin SDK côté serveur
#     (export RGPD, envoi de notifications, actions privilégiées).
#     Sur Firebase App Hosting / Cloud Run, l'authentification est automatique
#     via le compte de service : laisser vide dans ce cas.
# -----------------------------------------------------------------------------
# Chemin vers un fichier de compte de service (JAMAIS commité, JAMAIS en prod CI)
GOOGLE_APPLICATION_CREDENTIALS=
# Secret partagé pour appeler les Cloud Functions privilégiées depuis l'admin
ADMIN_API_SHARED_SECRET=

# -----------------------------------------------------------------------------
#  4. CLOUD FUNCTIONS — functions/.env.<projectId>
#     Variables SERVEUR uniquement. Déployées via `firebase deploy`,
#     jamais présentes dans Git.
# -----------------------------------------------------------------------------
# Clé d'API Expo Push (https://expo.dev > Account > Access tokens) — optionnelle
# mais recommandée en production pour éviter le rate limiting anonyme.
EXPO_ACCESS_TOKEN=
# URL publique de l'admin, utilisée dans les liens profonds des notifications
PUBLIC_ADMIN_URL=https://admin.exemple.fr
# Domaine des liens universels / deep links de l'application mobile
PUBLIC_APP_LINK_DOMAIN=https://app.exemple.fr

# -----------------------------------------------------------------------------
#  5. CI/CD — GitHub Actions Secrets (Settings > Secrets and variables > Actions)
#     Ces variables ne vivent JAMAIS dans un fichier du dépôt.
#     Elles ne sont listées ici que comme aide-mémoire de configuration.
# -----------------------------------------------------------------------------
# EXPO_TOKEN                    : jeton d'accès Expo (builds EAS) — secret
# FIREBASE_SERVICE_ACCOUNT_DEV  : JSON du compte de service du projet de dev — secret
# FIREBASE_SERVICE_ACCOUNT_PROD : JSON du compte de service du projet de prod — secret
# FIREBASE_PROJECT_ID_DEV       : identifiant du projet Firebase de dev — variable
# FIREBASE_PROJECT_ID_PROD      : identifiant du projet Firebase de prod — variable
# NEXT_PUBLIC_FIREBASE_*        : configuration client admin, injectée au build — variables
# SENTRY_AUTH_TOKEN             : si Sentry est activé plus tard — secret
