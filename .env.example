# Public Firebase web configuration. These identifiers are not Admin credentials,
# but production values should still be injected per environment.
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-freres-lumieres.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-freres-lumieres
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-freres-lumieres.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-me
NEXT_PUBLIC_FIREBASE_APP_ID=replace-me

EXPO_PUBLIC_FIREBASE_API_KEY=replace-me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-freres-lumieres.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-freres-lumieres
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-freres-lumieres.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace-me
EXPO_PUBLIC_FIREBASE_APP_ID=replace-me

# Local development only. Never set this to a production project ID.
FIREBASE_PROJECT_ID=demo-freres-lumieres
FIREBASE_EMULATOR_HOST=127.0.0.1
