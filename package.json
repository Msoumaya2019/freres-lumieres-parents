{
  "name": "freres-lumieres",
  "version": "0.1.0",
  "private": true,
  "description": "Application mobile + interface web d'administration pour la FCPE des écoles Frères Lumières (Montmagny)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "build:packages": "npm run build -w @fl/types -w @fl/shared -w @fl/firebase",
    "clean:packages": "npm run clean -w @fl/types -w @fl/shared -w @fl/firebase",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "workflows:check": "node scripts/check-workflows.mjs",
    "schema:check": "node scripts/verifier-schema-supabase.mjs",
    "dev:mobile": "npm run start -w @fl/mobile",
    "dev:admin": "npm run dev -w @fl/admin",
    "dev:emulators": "firebase emulators:start --only auth,firestore,storage,functions",
    "emulators:export": "firebase emulators:export ./firebase/emulator-data --force",
    "rules:test": "firebase emulators:exec --only firestore,storage \"npm run test -w @fl/testing\"",
    "seed:reference": "node scripts/seed-reference-data.mjs",
    "seed:channels": "node scripts/seed-channels.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:admin": "npm run build -w @fl/admin"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "firebase-admin": "^14.4.0",
    "firebase-tools": "^15.30.1",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2"
  }
}
