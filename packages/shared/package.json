{
  "name": "@fl/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Logique métier partagée : permissions, audiences, validation, thème, formatage, envoi push",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fl/types": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
