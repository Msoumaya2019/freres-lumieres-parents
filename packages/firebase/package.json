{
  "name": "@fl/firebase",
  "version": "0.1.0",
  "private": true,
  "description": "Accès Firebase : chemins, converters, repositories typés, notifications",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@fl/shared": "*",
    "@fl/types": "*",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
